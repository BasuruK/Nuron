# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# --- Postgres --------------------------------------------------------------
# Bootstrap superuser, used once at first init to create the nuron_ai/nuron_api
# schemas and roles (schema.sql). Application code never connects as this user.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nuron

# Passwords for the two schema-scoped login roles schema.sql creates via psql
# \getenv -- never hardcoded in schema.sql itself.
NURON_AI_DB_PASSWORD=changeme
NURON_API_DB_PASSWORD=changeme

# --- Neo4j -------------------------------------------------------------------
# Community edition has exactly one user, `neo4j`.
NEO4J_PASSWORD=changeme

# --- RustFS ------------------------------------------------------------------
RUSTFS_ACCESS_KEY=changeme
RUSTFS_SECRET_KEY=changeme

# --- LLM (OpenAILike -- any OpenAI-compatible endpoint) ----------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Compatible (non-OpenAI) endpoints need these stated explicitly.
OPENAI_IS_CHAT_MODEL=true
OPENAI_IS_FUNCTION_CALLING_MODEL=true

# --- Embeddings --------------------------------------------------------------
# One-way door once real content exists (ADR-0004): the model id and dimension
# count are baked into the Neo4j vector index at creation time.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# --- PDF extraction ------------------------------------------------------
# Off by default -- dev/test only against LlamaParse (PRD §5.1).
LLAMA_PARSE_ENABLED=false
LLAMA_PARSE_API_KEY=

# --- Watcher -------------------------------------------------------------
SCAN_INTERVAL_HOURS=24
# Decoupled from the scan interval on purpose -- see tracer-bullet-01.md.
MTIME_STABILITY_WINDOW_SECONDS=30

# --- Upload --------------------------------------------------------------
# PHP's `M` ini shorthand is already binary (25M = 25 MiB), matching Laravel's
# `max:25600` KB exactly. post_max_size carries 1 MiB of multipart headroom so an
# oversized file is rejected before Laravel finishes parsing it, not after --
# setting both to the same value would let a 25-26 MiB file be fully parsed first.
UPLOAD_MAX_FILESIZE=25M
POST_MAX_SIZE=26M

# --- Attribution fallback --------------------------------------------------
# Used only when a document's own content has no attribution. Never called
# `author` -- that name is reserved for what a citation actually claims a
# person said or decided (CONTEXT.md).
SOURCE_OWNER=
